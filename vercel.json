{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://atelie-juliabrandao-backend-production.up.railway.app/sitemap.xml"
    },
    { "source": "/(.*)", "destination": "/" }
  ],
  "redirects": [
    {
      "source": "/produtos/bebe-reborn-:slug*",
      "destination": "/produto/:slug*",
      "permanent": true
    },
    {
      "source": "/produtos/:slug*",
      "destination": "/produto/:slug*",
      "permanent": true
    }
  ]
}